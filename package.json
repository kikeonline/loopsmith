{
  "name": "loopsmith",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "node scripts/check-accessibility.mjs && node scripts/check-accessibility.mjs src/lib/project/fixtures/modifiers.loopsmith.json modifiers && node scripts/check-accessibility.mjs src/lib/project/fixtures/arrangement.loopsmith.json arrangement"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@strudel/web": "1.3.0",
    "acorn": "8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "22.20.5",
    "chrome-launcher": "^1.2.3",
    "fast-check": "4.10.2",
    "lighthouse": "^13.6.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kikeonline/loopsmith.git"
  }
}
